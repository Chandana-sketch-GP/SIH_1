# Local demo configuration only. Do not commit real credentials.
# Leave SECRET_KEY blank to have the app generate and save a private local key in instance/.secret_key.
SECRET_KEY=
DATABASE_URL=sqlite:///aicte.db
FLASK_DEBUG=0
COOKIE_SECURE=0
MAX_CONTENT_LENGTH=20971520

# Optional email: configure only with a mailbox you control.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_USE_SSL=0
AICTE_DEFAULT_EMAIL=

# Local demo only: server-assigned application review deadline, in days (1-365).
DEMO_REVIEW_SLA_DAYS=30
